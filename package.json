{
  "name": "ui-craft",
  "version": "11.2.0",
  "private": true,
  "description": "UI/UX design skill for televisions, kiosks, POS, handhelds, wearables, car HUDs, AR/VR, multi-screen workstations, foldables, home panels, dashboards, websites and mobile interfaces, with an interactive HTML gallery.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node serve-review.cjs",
    "test": "node --test scripts/release.test.cjs",
    "test:spatial": "node scripts/spatial-browser.cjs",
    "test:paper": "node scripts/paper-browser.cjs",
    "test:comparison": "node scripts/comparison-browser.cjs",
    "probe:layout": "node scripts/layout-probe.cjs",
    "probe:interaction": "node scripts/interaction-probe.cjs",
    "shots": "node scripts/capture-shots.cjs",
    "bundle": "node scripts/bundle-skill.cjs"
  }
}
